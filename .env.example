# ═══════════════════════════════════════════════════════════════════════════
# BP Passport — environment
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy to .env.local and fill in. .env.local is gitignored.
#
# NOTHING HERE IS REQUIRED FOR OFFLINE MODE. The audit and local passport work
# with no configuration. Supabase, account recovery, cross-device sync,
# consent history, clinician sharing, and clinician review require the values
# documented below. Apply db/migrations/*.sql in numeric order through 0011.

# ── Supabase ───────────────────────────────────────────────────────────────
# Create a project at supabase.com, region Singapore or Mumbai (lowest latency
# to Pakistan). Then apply db/migrations/*.sql in numeric order through 0011.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# API origin. Leave empty when the API routes run in this same Next.js app.
# For a separate API deployment, use its public HTTPS URL.
NEXT_PUBLIC_API_URL=

# Backend-only. Required when the API is hosted separately from the frontend.
# Example: https://bp-passport.vercel.app
WEB_ORIGIN=

# Server-only. Bypasses row-level security, so it must never carry a
# NEXT_PUBLIC_ prefix and must never reach a browser bundle. Required by the
# clinician review endpoint; patient and clinician record APIs never use it.
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-secret>

# ── Application-layer cryptography ─────────────────────────────────────────
# Generate each with: openssl rand -hex 32
#
# These are held by the APPLICATION, never by the database. That separation is
# the point: if Postgres computed the phone HMAC it would need the pepper, and a
# database compromise would then yield both the hashes and the secret that makes
# them irreversible.

# HMAC-SHA256 pepper for phone numbers. A Pakistani mobile has ~10^9 possible
# values, so a bare SHA-256 digest is exhaustible in seconds and is NOT
# anonymisation. Rotating this invalidates every stored phone_hmac, so treat it
# as permanent once real users exist.
PHONE_PEPPER=<generate-a-random-64-character-hex-value>

# AES-256-GCM key for PII columns (currently clinician names). Required for
# clinician registration. Losing it makes stored names permanently unreadable
# — back it up somewhere other than this repo.
PII_ENCRYPTION_KEY=<generate-a-random-64-character-hex-value>

# ── Consent ────────────────────────────────────────────────────────────────
# Bumped whenever the consent wording materially changes. Consent to v1 text is
# not consent to v2 text; changing this triggers re-consent.
NEXT_PUBLIC_CONSENT_POLICY_VERSION=v1

# ── AI assistant (optional) ────────────────────────────────────────────────
# Server-only. Without a key/model the assistant uses its deterministic local
# coach. With any provider configured, emergency triage still runs first and
# every generated reply passes through lib/clinical/drap-guardrail.ts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# ── Telemetry (optional) ───────────────────────────────────────────────────
# Measures the exact pilot KPI gates: QR scan -> registration, quiz completion,
# amber/red referral click-through.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=

# ── Admin ──────────────────────────────────────────────────────────────────
# Gate for the clinician verification queue at /admin. Use at least 32 random
# characters; it is compared in constant time and never stored by the UI.
ADMIN_TOKEN=<generate-a-random-secret>

# Required for clinician sharing; generate a stable random secret of at least
# 32 characters. Rotating it invalidates outstanding share links.
SHARE_TOKEN_PEPPER=<generate-a-random-secret-at-least-32-characters>
